+    /// Camera cards normally expose a known media root such as DCIM. Standalone
+    /// recorder volumes (including DJI Mic media) may instead keep audio at the
+    /// volume root or in a shallow RECORD-style directory. Probe only a few
+    /// levels so a mounted working drive is not recursively crawled.
+    static func containsSupportedMedia(at mountPath: String, hasMediaRoot: Bool) -> Bool {
+        if hasMediaRoot { return true }
+        let root = URL(fileURLWithPath: mountPath, isDirectory: true)
+        let rootDepth = root.standardizedFileURL.pathComponents.count
+        let keys: Set<URLResourceKey> = [.isDirectoryKey, .isRegularFileKey]
+        guard let enumerator = FileManager.default.enumerator(
+            at: root,
+            includingPropertiesForKeys: Array(keys),
+            options: [.skipsHiddenFiles, .skipsPackageDescendants]
+        ) else { return false }
+        for case let url as URL in enumerator {
+            let depth = url.standardizedFileURL.pathComponents.count - rootDepth
+            guard let values = try? url.resourceValues(forKeys: keys) else { continue }
+            if values.isDirectory == true, depth >= 3 {
+                enumerator.skipDescendants()
+                continue
+            }
+            if values.isRegularFile == true,
+               supportedMediaExtensions.contains(url.pathExtension.lowercased()) {
+                return true
+            }
+        }
+        return false
+    }
+
